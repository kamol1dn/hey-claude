{
  "id": "echo",
  "name": "Echo",
  "kind": "pixel bat",
  "line": "A pocket-sized bat with satellite-dish ears. Hears everything, says just enough.",
  "author": "hey-claude",
  "licence": "MIT",
  "registry": "1.1",
  "implements": ["idle", "off", "listening", "thinking", "talking", "happy", "confused", "working", "sending",
                 "drowsy", "asleep", "waking", "woke", "approval_needed"],
  "oneshot": {"happy": 2.9, "confused": 2.8, "sending": 3.6, "waking": 1.6, "woke": 0.6},
  "size": {"pill": 24, "desktop": 120},
  "bounds": [-60, -60, 120, 120],
  "desktop_bounds": [-100, -80, 200, 170],
  "antics": [
    {"id": "hang", "name": "Hangs upside down", "duration": 8, "weight": 4, "cooldown": 600, "min_idle": 60,
     "where": ["pill", "desktop"],
     "props": [{"id": "perch", "box": [-60, -50, 120, 8]}],
     "exit": "drops right side up with a startled flap"},
    {"id": "moth", "name": "Catches a moth", "duration": 7, "weight": 3, "cooldown": 900, "min_idle": 120,
     "where": ["pill", "desktop"], "when": {"hours": [19, 6]},
     "props": [{"id": "moth", "box": [-60, -60, 120, 100]}],
     "exit": "the moth flutters off, Echo blinks"},
    {"id": "ping", "name": "Echolocation pings", "duration": 5, "weight": 5, "cooldown": 300, "min_idle": 30,
     "where": ["pill", "desktop"],
     "props": [{"id": "sonar arcs", "box": [-60, -60, 120, 110]}],
     "exit": "the last ping fades out"},
    {"id": "spooked", "name": "Spooked by its own echo", "duration": 4.5, "weight": 2, "cooldown": 1500, "min_idle": 300,
     "where": ["pill", "desktop"],
     "props": [{"id": "loud echo", "box": [-60, -60, 120, 110]}],
     "exit": "a flash of embarrassment, a little !"},
    {"id": "groom", "name": "Grooms its wings", "duration": 7, "weight": 4, "cooldown": 600, "min_idle": 90,
     "where": ["pill", "desktop"],
     "props": [{"id": "fur tufts", "box": [-60, -30, 120, 90]}],
     "exit": "drops the wing, a tuft of fur floats down"},
    {"id": "stars", "name": "Counts the stars", "duration": 12, "weight": 3, "cooldown": 2400, "min_idle": 300,
     "where": ["desktop"], "when": {"hours": [20, 5]},
     "props": [{"id": "night sky", "box": [-100, -80, 200, 125]}, {"id": "count", "box": [50, -45, 20, 30]}],
     "exit": "the stars wink out"},
    {"id": "snow", "name": "A snowflake lands on its ear", "duration": 6, "weight": 4, "cooldown": 900, "min_idle": 60,
     "where": ["pill", "desktop"], "when": {"months": [12, 1, 2]},
     "props": [{"id": "snowflakes", "box": [-60, -60, 120, 120]}],
     "exit": "the flake slides off the ear and melts"},
    {"id": "doze", "name": "Dozes off mid-hang", "duration": 8, "weight": 2, "cooldown": 1800, "min_idle": 900,
     "where": ["pill", "desktop"],
     "props": [{"id": "perch", "box": [-60, -50, 120, 8]}, {"id": "z", "box": [20, -40, 40, 50]}],
     "exit": "the z's pop, a jolt awake"},
    {"id": "sonar", "name": "Draws a sonar map", "duration": 8, "weight": 2, "cooldown": 1800, "min_idle": 600,
     "where": ["desktop"],
     "props": [{"id": "sonar map", "box": [-100, -80, 200, 170]}],
     "exit": "the map dots blink out"},
    {"id": "chase", "name": "Chases its own ping", "duration": 7, "weight": 3, "cooldown": 900, "min_idle": 180,
     "where": ["desktop"],
     "props": [{"id": "ping ball", "box": [-100, -70, 200, 130]}],
     "exit": "the ping fizzles, Echo's back on its spot"},
    {"id": "hiccup", "name": "Sonar hiccups", "duration": 6, "weight": 2, "cooldown": 1500, "min_idle": 240,
     "where": ["pill", "desktop"],
     "props": [{"id": "hiccup pings", "box": [-30, -60, 60, 80]}],
     "exit": "one last tiny hic"},
    {"id": "tune", "name": "Tunes in a faraway song", "duration": 7, "weight": 3, "cooldown": 900, "min_idle": 120,
     "where": ["pill", "desktop"],
     "props": [{"id": "notes", "box": [25, -60, 35, 50]}],
     "exit": "the note drops, ears snap upright"},
    {"id": "rain", "name": "Shelters from the rain", "duration": 9, "weight": 4, "cooldown": 1200, "min_idle": 60,
     "where": ["desktop"], "when": {"weather": ["rain", "storm"]},
     "props": [{"id": "rain cloud", "box": [-100, -80, 200, 40]}, {"id": "drops", "box": [-100, -60, 200, 150]}],
     "exit": "the cloud lifts off, a few last drops"}
  ]
}
