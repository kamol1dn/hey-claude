{
  "id": "tycho",
  "name": "Tycho",
  "kind": "one-eyed orrery",
  "line": "A small planet with one curious eye and three moons. The moons do the fidgeting, so the eye can stay calm.",
  "author": "hey-claude",
  "licence": "MIT",
  "registry": "1.1",
  "implements": ["idle", "off", "listening", "thinking", "talking", "happy", "confused", "working", "sending",
                 "drowsy", "asleep", "waking", "woke", "approval_needed"],
  "oneshot": {"happy": 2.9, "confused": 2.8, "sending": 3.2, "waking": 1.6, "woke": 0.9},
  "size": {"pill": 24, "desktop": 120},
  "bounds": [-60, -60, 120, 120],
  "desktop_bounds": [-100, -80, 200, 170],
  "antics": [
    {"id": "eclipse", "name": "A lunar eclipse", "duration": 9, "weight": 3, "cooldown": 1200, "min_idle": 180,
     "where": ["pill", "desktop"],
     "exit": "the moon flashes back to white and snaps into orbit, Tycho blinks"},
    {"id": "count", "name": "Counts its moons", "duration": 8, "weight": 4, "cooldown": 900, "min_idle": 60,
     "where": ["pill", "desktop"],
     "props": [{"id": "fourth-star", "box": [26, -54, 22, 22]}],
     "exit": "the moons scatter back into orbit, Tycho blinks"},
    {"id": "comet", "name": "A comet passes", "duration": 7, "weight": 3, "cooldown": 1500, "min_idle": 120,
     "where": ["pill", "desktop"],
     "props": [{"id": "comet", "box": [-60, -60, 120, 36]}],
     "exit": "the comet zips off, Tycho blinks"},
    {"id": "telescope", "name": "A telescope peek", "duration": 9, "weight": 3, "cooldown": 1500, "min_idle": 240,
     "where": ["pill", "desktop"],
     "props": [{"id": "telescope", "box": [0, -52, 56, 50]}],
     "exit": "the spyglass snaps shut"},
    {"id": "meteors", "name": "A meteor shower", "duration": 10, "weight": 4, "cooldown": 2400, "min_idle": 300,
     "where": ["pill", "desktop"], "when": {"hours": [21, 5]},
     "props": [{"id": "night-sky", "box": [-60, -60, 120, 34]}],
     "exit": "the stars go out at once"},
    {"id": "juggle", "name": "Juggles its moons", "duration": 9, "weight": 3, "cooldown": 1200, "min_idle": 180,
     "where": ["pill", "desktop"],
     "exit": "Tycho drops the moons and they snap back into orbit"},
    {"id": "hula", "name": "Hula hoop", "duration": 8, "weight": 2, "cooldown": 1800, "min_idle": 240,
     "where": ["pill", "desktop"],
     "exit": "the ring twangs flat again"},
    {"id": "aurora", "name": "Aurora shimmer", "duration": 10, "weight": 3, "cooldown": 2400, "min_idle": 300,
     "where": ["pill", "desktop"], "when": {"months": [11, 12, 1, 2]},
     "props": [{"id": "aurora", "box": [-40, -58, 80, 40]}],
     "exit": "the curtains of light drop away"},
    {"id": "satellite", "name": "A satellite drifts by", "duration": 8, "weight": 3, "cooldown": 1500, "min_idle": 180,
     "where": ["pill", "desktop"],
     "props": [{"id": "satellite", "box": [-60, -60, 120, 40]}],
     "exit": "the satellite boosts out of sight"},
    {"id": "stray", "name": "One moon wanders off", "duration": 12, "weight": 2, "cooldown": 2400, "min_idle": 420,
     "where": ["pill", "desktop"],
     "exit": "all three moons snap home, Tycho blinks"},
    {"id": "corona", "name": "A tiny solar eclipse", "duration": 9, "weight": 2, "cooldown": 3600, "min_idle": 600,
     "where": ["desktop"],
     "props": [{"id": "sun", "box": [-94, -76, 58, 52]}],
     "exit": "the little sun ducks away, the moon snaps back"},
    {"id": "farside", "name": "Shows its far side", "duration": 7, "weight": 3, "cooldown": 1200, "min_idle": 120,
     "where": ["pill", "desktop"],
     "exit": "Tycho whips back round to face you"},
    {"id": "constellation", "name": "Draws itself in the stars", "duration": 12, "weight": 2, "cooldown": 3600, "min_idle": 600,
     "where": ["desktop"],
     "props": [{"id": "constellation", "box": [-96, -74, 66, 46]}],
     "exit": "the star lines blink out, the pen-moon snaps home"}
  ]
}
