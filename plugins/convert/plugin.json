{
 "id": "convert",
 "api": "1.0",
 "name": "Calculator & converter",
 "description": "Arithmetic, units and currencies (exchange rates fetched and cached), on a card.",
 "version": "1.0.0",
 "author": "hey-claude",
 "glyph": "calc",
 "permissions": [
  "network"
 ],
 "contributes": {
  "widgets": [
