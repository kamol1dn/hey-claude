{
  "_doc": [
    "Tool -> island effect (ROADMAP M9 section 3). The data contract only: heyclaude/effects.py turns a",
    "tool call into an effect event, and the island paints it (QPainter today, QML in M5).",
    "effect: generic | volume | mute | brightness | theme | media | flash | confirm.",
    "data: event fields read from the call, as paths into {input, result} (e.g. result.old).",
    "fmt: how from/to read as text: percent | onoff | mode | basename | track | text | none.",
    "label may hold {path} placeholders. A tool that isn't listed but returns {old, new} gets the",
    "fallback (service icon + old -> new). Tools in 'silent' never show anything."
  ],
  "version": 1,
  "ttl_s": 8,
  "fallback": {"effect": "generic", "icon": "gear", "label": "{tool_short}", "fmt": "text",
               "data": {"from": "result.old", "to": "result.new"}},
  "silent": [
    "mcp__windows__get_volume", "mcp__windows__list_app_volumes", "mcp__windows__list_audio_devices",
    "mcp__windows__get_brightness", "mcp__windows__get_theme", "mcp__windows__get_wallpaper",
    "mcp__windows__get_night_light", "mcp__windows__get_radios", "mcp__windows__battery_status",
    "mcp__windows__get_power_mode", "mcp__windows__list_apps", "mcp__windows__list_windows",
    "mcp__windows__get_clipboard"
  ],
  "tools": {
    "mcp__windows__set_volume": {"effect": "volume", "icon": "speaker", "label": "Volume", "fmt": "percent",
                                 "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_app_volume": {"effect": "volume", "icon": "speaker", "label": "{result.app}", "fmt": "percent",
                                     "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_mute": {"effect": "mute", "icon": "speaker", "label": "Sound", "fmt": "none",
                               "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_brightness": {"effect": "brightness", "icon": "sun", "label": "Brightness", "fmt": "percent",
                                     "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_theme": {"effect": "theme", "icon": "moon", "label": "Colour mode", "fmt": "mode",
                                "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_wallpaper": {"effect": "generic", "icon": "image", "label": "Wallpaper", "fmt": "basename",
                                    "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_night_light": {"effect": "generic", "icon": "moon", "label": "Night light", "fmt": "onoff",
                                      "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_wifi": {"effect": "generic", "icon": "wifi", "label": "Wi-Fi", "fmt": "onoff",
                               "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_bluetooth": {"effect": "generic", "icon": "bluetooth", "label": "Bluetooth", "fmt": "onoff",
                                    "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_power_mode": {"effect": "generic", "icon": "bolt", "label": "Power mode", "fmt": "mode",
                                     "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__set_default_output_device": {"effect": "generic", "icon": "speaker", "label": "Output",
                                                "fmt": "text", "data": {"from": "result.old", "to": "result.new"}},
    "mcp__windows__media_control": {"effect": "media", "icon": "music", "label": "{result.action}", "fmt": "track",
                                    "data": {"from": "result.old", "to": "result.new", "action": "result.action"}},
    "mcp__windows__now_playing": {"effect": "media", "icon": "music", "label": "Now playing", "fmt": "track",
                                  "data": {"to": "result"}},
    "mcp__windows__launch_app": {"effect": "generic", "icon": "app", "label": "Opened", "fmt": "text",
                                 "data": {"to": "result.launched"}},
    "mcp__windows__focus_window": {"effect": "generic", "icon": "window", "label": "Switched to", "fmt": "text",
                                   "data": {"to": "result.new"}},
    "mcp__windows__minimize_window": {"effect": "generic", "icon": "window", "label": "Minimized", "fmt": "text",
                                      "data": {"to": "result.title"}},
    "mcp__windows__restore_window": {"effect": "generic", "icon": "window", "label": "Restored", "fmt": "text",
                                     "data": {"to": "result.title"}},
    "mcp__windows__snap_window": {"effect": "generic", "icon": "window", "label": "Snapped {result.new}", "fmt": "text",
                                  "data": {"to": "result.title"}},
    "mcp__windows__close_window": {"effect": "generic", "icon": "window", "label": "Closed", "fmt": "text",
                                   "data": {"to": "result.closed"}},
    "mcp__windows__set_clipboard": {"effect": "generic", "icon": "clipboard", "label": "Copied", "fmt": "none",
                                    "data": {}},
    "mcp__windows__open_settings_page": {"effect": "generic", "icon": "gear", "label": "Settings", "fmt": "text",
                                         "data": {"to": "result.opened"}},
    "mcp__windows__lock_pc": {"effect": "generic", "icon": "lock", "label": "Locked", "fmt": "none", "data": {}},
    "mcp__windows__request_power_action": {"effect": "confirm", "icon": "power", "label": "{result.pending}",
                                           "fmt": "none", "data": {"action": "result.pending"}, "ttl_s": 20},
    "mcp__windows__screenshot": {"effect": "flash", "icon": "camera", "label": "Looking at your screen", "fmt": "none",
                                 "data": {}, "ttl_s": 2.5},
    "mcp__windows-mcp__Screenshot": {"effect": "flash", "icon": "camera", "label": "Looking at your screen",
                                     "fmt": "none", "data": {}, "ttl_s": 2.5},
    "mcp__windows-mcp__Snapshot": {"effect": "flash", "icon": "camera", "label": "Reading the screen", "fmt": "none",
                                   "data": {}, "ttl_s": 2.5}
  }
}
