 "schema": {
  "type": "object",
  "required": [
   "kind",
   "title"
  ],
  "properties": {
   "kind": {
    "type": "string",
    "enum": [
     "route",
     "place"
    ]
   },
   "title": {
    "type": "string",
    "maxLength": 60
   },
   "mode": {
    "type": "string",
    "enum": [
     "driving",
     "walking",
     "cycling"
    ]
   },
   "how": {
    "type": "string",
    "maxLength": 12
   },
   "origin": {
    "type": "string",
    "maxLength": 60
   },
   "dest": {
    "type": "string",
    "maxLength": 60
   },
   "duration": {
    "type": "string",
    "maxLength": 20
   },
   "distance": {
    "type": "string",
    "maxLength": 20
   },
   "arrive": {
    "type": "string",
    "pattern": "^\\d{1,2}:\\d{2}$"
   },
   "name": {
    "type": "string",
    "maxLength": 60
   },
   "address": {
    "type": "string",
    "maxLength": 110
   },
   "place_kind": {
    "type": "string",
    "maxLength": 24
   },
   "map": {
    "type": "string",
    "maxLength": 400,
    "pattern": "^(file:///\\S+/state/maps/map-[0-9a-f]+\\.png|sample_map\\.png)$"
   },
   "route": {
    "type": "array",
    "maxItems": 200,
    "items": {
     "type": "array",
     "maxItems": 2,
     "items": {
      "type": "number"
     }
    }
   },
   "pins": {
    "type": "array",
    "maxItems": 2,
    "items": {
     "type": "array",
     "maxItems": 2,
     "items": {
      "type": "number"
     }
    }
   },
   "attribution": {
    "type": "string",
    "maxLength": 40
   }
  }
 }
}