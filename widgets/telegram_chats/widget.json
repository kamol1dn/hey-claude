     "required": [
      "name"
     ],
     "properties": {
      "name": {
       "type": "string",
       "maxLength": 50
      },
      "unread": {
       "type": "integer",
       "minimum": 0
      },
      "last": {
       "type": "string",
       "maxLength": 120
      },
      "time": {
       "type": "string",
       "maxLength": 16
      },
      "avatar": {
       "type": "string",
       "maxLength": 300
      },
      "link": {
       "type": "string",
       "maxLength": 200,
       "pattern": "^tg://"
      }
     }
    }
   }
  }
 }
}
