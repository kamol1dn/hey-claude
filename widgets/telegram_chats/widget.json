 "size": {
  "width": 440,
  "max_height": 236
 },
 "private": true,
 "ttl_s": 12,
 "icon": "telegram",
 "example": {
  "chats": [
   {
    "name": "Aziz",
    "unread": 2,
    "last": "are we still on for 7?",
    "time": "18:42",
    "link": "tg://resolve?domain=aziz"
   },
   {
    "name": "Design crew",
    "unread": 14,
    "last": "Lin: new mocks are up",
    "time": "17:10"
   },
   {
    "name": "Mom",
    "unread": 1,
    "last": "call me when you can",
    "time": "16:05"
   },
   {
    "name": "Sam",
    "unread": 0,
    "last": "sounds good",
    "time": "15:47"
   }
  ]
 },
 "schema": {
  "type": "object",
  "required": [
   "chats"
  ],
  "properties": {
   "chats": {
    "type": "array",
    "maxItems": 6,
    "items": {
