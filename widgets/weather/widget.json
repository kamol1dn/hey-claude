{
 "id": "weather",
 "name": "Weather",
 "api": "1.0",
 "description": "current weather, a short forecast, and any alert, air quality, rain nowcast, sun and moon; asked how sure it is, the forecast models' agreement",
 "title": "Weather · {location}",
 "size": {
  "width": 440,
  "max_height": 280
 },
 "private": false,
 "ttl_s": 12,
 "glyph": "sun",
 "triggers": {
  "tools": [
   "mcp__weather__get_weather",
   "mcp__weather-mcp__get_weather_summary",
   "mcp__weather-mcp__get_current_conditions",
   "mcp__weather-mcp__get_forecast"
  ],
  "data": "weather"
 },
 "example": {
