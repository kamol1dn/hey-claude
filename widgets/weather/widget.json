 "schema": {
  "type": "object",
  "required": [
   "location",
   "temp"
  ],
  "properties": {
   "location": {
    "type": "string",
    "maxLength": 60
   },
   "temp": {
    "type": "number"
   },
   "unit": {
    "type": "string",
    "enum": [
     "C",
     "F"
    ]
   },
   "condition": {
    "type": "string",
    "maxLength": 40
   },
   "icon": {
    "type": "string",
    "enum": [
     "sun",
     "partly",
     "cloud",
     "rain",
     "storm",
     "snow",
     "fog",
     "wind",
     "night"
    ]
   },
   "high": {
    "type": "number"
   },
   "low": {
    "type": "number"
   },
   "hourly": {
    "type": "array",
    "maxItems": 6,
    "items": {
     "type": "object",
     "required": [
      "time",
      "temp"
     ],
     "properties": {
      "time": {
       "type": "string",
       "maxLength": 8
      },
      "temp": {
       "type": "number"
      },
      "icon": {
       "type": "string",
       "enum": [
        "sun",
        "partly",
        "cloud",
        "rain",
        "storm",
        "snow",
        "fog",
        "wind",
        "night"
       ]
      }
     }
    }
   },
   "feels": {
    "type": "number"
   },
   "wind": {
    "type": "number"
   },
   "source": {
    "type": "string",
    "maxLength": 30
   },
   "days": {
    "type": "array",
    "maxItems": 3,
    "items": {
     "type": "object",
     "required": [
      "day",
      "low",
      "high"
     ],
     "properties": {
      "day": {
       "type": "string",
       "maxLength": 10
      },
      "low": {
       "type": "number"
      },
      "high": {
       "type": "number"
      },
      "icon": {
       "type": "string",
       "enum": [
        "sun",
        "partly",
        "cloud",
        "rain",
        "storm",
        "snow",
        "fog",
        "wind",
        "night"
       ]
      }
     }
    }
   },
   "alert": {
    "type": "object",
    "required": [
     "title",
     "severity"
    ],
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 60
     },
     "severity": {
      "type": "string",
      "enum": [
       "minor",
       "moderate",
       "severe",
       "extreme",
       "unknown"
      ]
     },
     "level": {
      "type": "string",
      "enum": [
       "green",
       "yellow",
       "orange",
       "red"
      ]
     },
     "source": {
      "type": "string",
      "maxLength": 40
     },
     "until": {
      "type": "string",
      "maxLength": 12
     },
     "more": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "air": {
    "type": "object",
    "properties": {
     "aqi": {
      "type": "number",
      "minimum": 0
     },
     "scale": {
      "type": "string",
      "enum": [
       "EU",
       "US"
      ]
     },
     "label": {
      "type": "string",
      "maxLength": 24
     },
     "color": {
      "type": "string",
      "enum": [
       "green",
       "yellow",
       "orange",
       "red",
       "purple",
       "maroon"
      ]
     },
     "uv": {
      "type": "number",
      "minimum": 0
     },
     "pollen": {
      "type": "string",
      "maxLength": 24
     }
    }
   },
   "nowcast": {
    "type": "object",
    "required": [
     "text",
     "steps"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 40
     },
     "steps": {
      "type": "array",
      "maxItems": 8,
      "items": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      }
     },
     "start": {
      "type": "string",
      "maxLength": 8
     }
    }
   },
   "sun": {
    "type": "object",
    "required": [
     "rise",
     "set"
    ],
    "properties": {
     "rise": {
      "type": "string",
      "maxLength": 8
     },
     "set": {
      "type": "string",
      "maxLength": 8
     }
    }
   },
   "moon": {
    "type": "object",
    "required": [
     "phase"
    ],
    "properties": {
     "phase": {
      "type": "string",
      "maxLength": 24
     },
     "illum": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     },
     "waxing": {
      "type": "boolean"
     }
    }
   },
   "agreement": {
    "type": "object",
    "required": [
     "level",
     "head",
     "models"
    ],
    "properties": {
     "level": {
      "type": "string",
      "enum": [
       "high",
       "medium",
       "low"
      ]
     },
     "head": {
      "type": "string",
      "maxLength": 24
     },
     "detail": {
      "type": "string",
      "maxLength": 48
     },
     "text": {
      "type": "string",
      "maxLength": 72
     },
     "day": {
      "type": "string",
      "maxLength": 12
     },
     "date": {
      "type": "string",
      "maxLength": 10
     },
     "models": {
      "type": "array",
      "maxItems": 8,
      "items": {
       "type": "object",
       "required": [
        "name",
        "high",
        "low"
       ],
       "properties": {
        "name": {
         "type": "string",
         "maxLength": 16
        },
        "high": {
         "type": "number"
        },
        "low": {
         "type": "number"
        },
        "pop": {
         "type": "integer",
         "minimum": 0,
         "maximum": 100
        },
        "rain": {
         "type": "number",
         "minimum": 0
        }
       }
      }
     },
     "odd": {
      "type": "object",
      "required": [
       "name",
       "side"
      ],
      "properties": {
       "name": {
        "type": "string",
        "maxLength": 16
       },
       "side": {
        "type": "string",
        "enum": [
         "cold",
         "warm"
        ]
       }
      }
     }
    }
   }
  }
 }
}
